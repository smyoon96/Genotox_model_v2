\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three-level evaluation framework for genotoxicity QSAR. All three levels use the same locked configuration (XGBoost, compact features, raw SMILES) to enable fair comparison of MCC across evaluation methods. The overestimation hierarchy summarizes the relative magnitudes observed in this benchmark.}}{20}{figure.caption.37}\protected@file@percent }
\newlabel{fig:framework}{{1}{20}{Three-level evaluation framework for genotoxicity QSAR. All three levels use the same locked configuration (XGBoost, compact features, raw SMILES) to enable fair comparison of MCC across evaluation methods. The overestimation hierarchy summarizes the relative magnitudes observed in this benchmark}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mean MCC ($\pm $SD) by algorithm across all feature modes and preprocessing scenarios, grouped by endpoint. Error bars represent $\pm $1 SD. Within each endpoint, the top five tabular models show minimal performance spread (Ames range = 0.023 excluding LR and GCN).}}{20}{figure.caption.38}\protected@file@percent }
\newlabel{fig:model_comparison}{{2}{20}{Mean MCC ($\pm $SD) by algorithm across all feature modes and preprocessing scenarios, grouped by endpoint. Error bars represent $\pm $1 SD. Within each endpoint, the top five tabular models show minimal performance spread (Ames range = 0.023 excluding LR and GCN)}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Evaluation rigor cascade for Ames mutagenicity (locked configuration: XGBoost, compact features, raw SMILES). MCC decreases from random-split CV (0.670) through scaffold-split CV (0.624) and scaffold-split held-out test (0.470) to cross-source-domain LDO (0.234 drug$\to $industrial, 0.122 industrial$\to $drug). The source-domain effect ($\Delta = 0.390$, scaffold CV to LDO) substantially exceeds the split-method effect ($\Delta = 0.046$). All values from the same model, features, and preprocessing.}}{21}{figure.caption.39}\protected@file@percent }
\newlabel{fig:cascade}{{3}{21}{Evaluation rigor cascade for Ames mutagenicity (locked configuration: XGBoost, compact features, raw SMILES). MCC decreases from random-split CV (0.670) through scaffold-split CV (0.624) and scaffold-split held-out test (0.470) to cross-source-domain LDO (0.234 drug$\to $industrial, 0.122 industrial$\to $drug). The source-domain effect ($\Delta = 0.390$, scaffold CV to LDO) substantially exceeds the split-method effect ($\Delta = 0.046$). All values from the same model, features, and preprocessing}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Source-domain composition and cross-domain robustness in the Ames dataset. (A)~Positive rate by source domain: drug-sourced 58.3\% vs.\ industrial-sourced 3.0\% (19.5-fold difference). (B)~Leave-domain-out MCC for three algorithms. Drug$\to $industrial generalization is consistent across algorithms, but industrial$\to $drug direction reveals Random Forest's substantially better robustness (MCC = 0.325 vs.\ XGBoost 0.122).}}{22}{figure.caption.40}\protected@file@percent }
\newlabel{fig:domain}{{4}{22}{Source-domain composition and cross-domain robustness in the Ames dataset. (A)~Positive rate by source domain: drug-sourced 58.3\% vs.\ industrial-sourced 3.0\% (19.5-fold difference). (B)~Leave-domain-out MCC for three algorithms. Drug$\to $industrial generalization is consistent across algorithms, but industrial$\to $drug direction reveals Random Forest's substantially better robustness (MCC = 0.325 vs.\ XGBoost 0.122)}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Effect of salt stripping on mean MCC (averaged across all models and feature modes) by endpoint. Salt stripping improved in~vivo mean MCC from 0.048 to 0.111 ($\Delta = +0.063$); the best individual in~vivo model showed a larger improvement of +0.225 (raw MCC = 0.086 $\to $ salt-stripped MCC = 0.311). Ames showed mixed effects; in~vitro showed a decrease.}}{22}{figure.caption.41}\protected@file@percent }
\newlabel{fig:salt}{{5}{22}{Effect of salt stripping on mean MCC (averaged across all models and feature modes) by endpoint. Salt stripping improved in~vivo mean MCC from 0.048 to 0.111 ($\Delta = +0.063$); the best individual in~vivo model showed a larger improvement of +0.225 (raw MCC = 0.086 $\to $ salt-stripped MCC = 0.311). Ames showed mixed effects; in~vitro showed a decrease}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces SHAP feature importance (top 5 features) for each primary endpoint, computed from the best-performing tree-based model. Physicochemical descriptors (blue) dominate across all endpoints. Structural alert count (orange) ranks first for Ames but is absent from the in~vitro top 5. Individual fingerprint bits are absent from the top 5 for all endpoints despite comprising 50--75\% of features in the broad modes.}}{23}{figure.caption.42}\protected@file@percent }
\newlabel{fig:shap}{{6}{23}{SHAP feature importance (top 5 features) for each primary endpoint, computed from the best-performing tree-based model. Physicochemical descriptors (blue) dominate across all endpoints. Structural alert count (orange) ranks first for Ames but is absent from the in~vitro top 5. Individual fingerprint bits are absent from the top 5 for all endpoints despite comprising 50--75\% of features in the broad modes}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Learning curves for the locked configuration (XGBoost, compact features, raw SMILES). Ames MCC saturates by 30\% of training data; in~vitro shows a noisy upward trend; in~vivo is flat throughout, indicating that additional data does not improve classification under this configuration. Shaded regions represent $\pm $1 SD across 5-fold scaffold CV. Note: the in~vivo curve reflects the locked configuration only; the best-performing salt-stripped configuration was not evaluated.}}{23}{figure.caption.43}\protected@file@percent }
\newlabel{fig:learning_curves}{{7}{23}{Learning curves for the locked configuration (XGBoost, compact features, raw SMILES). Ames MCC saturates by 30\% of training data; in~vitro shows a noisy upward trend; in~vivo is flat throughout, indicating that additional data does not improve classification under this configuration. Shaded regions represent $\pm $1 SD across 5-fold scaffold CV. Note: the in~vivo curve reflects the locked configuration only; the best-performing salt-stripped configuration was not evaluated}{figure.caption.43}{}}
