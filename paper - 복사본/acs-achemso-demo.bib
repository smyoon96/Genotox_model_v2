@article{HASSELGREN2019104403,
title = {Genetic toxicology in silico protocol},
journal = {Regulatory Toxicology and Pharmacology},
volume = {107},
pages = {104403},
year = {2019},
issn = {0273-2300},
doi = {https://doi.org/10.1016/j.yrtph.2019.104403},
url = {https://www.sciencedirect.com/science/article/pii/S0273230019301655},
author = {Catrin Hasselgren and Ernst Ahlberg and Yumi Akahori and Alexander Amberg and Lennart T. Anger and Franck Atienzar and Scott Auerbach and Lisa Beilke and Phillip Bellion and Romualdo Benigni and Joel Bercu and Ewan D. Booth and Dave Bower and Alessandro Brigo and Zoryana Cammerer and Mark T.D. Cronin and Ian Crooks and Kevin P. Cross and Laura Custer and Krista Dobo and Tatyana Doktorova and David Faulkner and Kevin A. Ford and Marie C. Fortin and Markus Frericks and Samantha E. Gad-McDonald and Nichola Gellatly and Helga Gerets and Véronique Gervais and Susanne Glowienke and Jacky {Van Gompel} and James S. Harvey and Jedd Hillegass and Masamitsu Honma and Jui-Hua Hsieh and Chia-Wen Hsu and Tara S. Barton-Maclaren and Candice Johnson and Robert Jolly and David Jones and Ray Kemper and Michelle O. Kenyon and Naomi L. Kruhlak and Sunil A. Kulkarni and Klaus Kümmerer and Penny Leavitt and Scott Masten and Scott Miller and Chandrika Moudgal and Wolfgang Muster and Alexandre Paulino and Elena {Lo Piparo} and Mark Powley and Donald P. Quigley and M. Vijayaray Reddy and Andrea-Nicole Richarz and Benoit Schilter and Ronald D. Snyder and Lidiya Stavitskaya and Reinhard Stidl and David T. Szabo and Andrew Teasdale and Raymond R. Tice and Alejandra Trejo-Martin and Anna Vuorinen and Brian A. Wall and Pete Watts and Angela T. White and Joerg Wichard and Kristine L. Witt and Adam Woolley and David Woolley and Craig Zwickl and Glenn J. Myatt},
keywords = {,  toxicology, Computational toxicology protocols, (Q)SAR, Expert alerts, Expert review, Genetic toxicology},
abstract = {In silico toxicology (IST) approaches to rapidly assess chemical hazard, and usage of such methods is increasing in all applications but especially for regulatory submissions, such as for assessing chemicals under REACH as well as the ICH M7 guideline for drug impurities. There are a number of obstacles to performing an IST assessment, including uncertainty in how such an assessment and associated expert review should be performed or what is fit for purpose, as well as a lack of confidence that the results will be accepted by colleagues, collaborators and regulatory authorities. To address this, a project to develop a series of IST protocols for different hazard endpoints has been initiated and this paper describes the genetic toxicity in silico (GIST) protocol. The protocol outlines a hazard assessment framework including key effects/mechanisms and their relationships to endpoints such as gene mutation and clastogenicity. IST models and data are reviewed that support the assessment of these effects/mechanisms along with defined approaches for combining the information and evaluating the confidence in the assessment. This protocol has been developed through a consortium of toxicologists, computational scientists, and regulatory scientists across several industries to support the implementation and acceptance of in silico approaches.}
}

@article{YOON2026100405,
title = {Assessing the applicability domain of regulatory QSAR models for industrial chemicals: a quantitative evaluation using Ames data},
journal = {Computational Toxicology},
volume = {38},
pages = {100405},
year = {2026},
issn = {2468-1113},
doi = {https://doi.org/10.1016/j.comtox.2026.100405},
url = {https://www.sciencedirect.com/science/article/pii/S246811132600006X},
author = {Seungmin Yoon and Sanghun Kim and Hyunpyo Jeon},
keywords = {QSAR, Ames mutagenicity, Applicability domain, Industrial chemicals, Structural alerts},
abstract = {Regulatory quantitative structure–activity relationship (QSAR) models for Ames mutagenicity have been developed and validated primarily on drug-like organic compounds, whereas industrial chemicals include metal salts, ionic species, and multi-component structures that occupy chemical space substantially different from that of drug-like compounds. This study quantitatively evaluates the applicability domain (AD) of regulatory QSAR models for industrial chemicals using 7493 industrial substances with Ames data and a 7278-compound benchmark dataset used for model development. Benigni–Bossa structural alert detection, physicochemical descriptors, principal component analysis of Morgan fingerprints, and Mahalanobis distance–based AD metrics were used to compare chemical space coverage. Industrial chemicals showed lower structural alert coverage (16.5%) than benchmark compounds (34.0%), and only 9.9% of alert-positive industrial chemicals were Ames-positive compared with 74.8% in the benchmark set. Industrial compounds occupied broader and shifted regions of chemical space, with approximately 35% located outside the benchmark distribution. Application of regulatory tools revealed substantial domain limitations. The OECD QSAR Toolbox classified 67.5% of industrial chemicals as out-of-domain. The VEGA-QSAR Ames consensus model failed to process 25.5% of compounds, mainly multi-component, ionic, or metal-containing structures. Among successfully predicted compounds, sensitivity was 79.3%. When structural processing failures were considered, effective regulatory coverage of Ames-positive compounds decreased to 63.1%. These results demonstrate that current regulatory QSAR models have limited applicability and reduced effective coverage for industrial chemicals. Negative QSAR predictions for such substances should not be used as standalone evidence of non-mutagenicity without explicit AD verification. The findings support the need for industrial chemical–specific models and improved uncertainty and domain characterization in regulatory genotoxicity assessment.}
}
